# The Relay: the PRODUCTION environment, read by systemd (EnvironmentFile= in
# deploy/relay-game.service). Install it root-only, then fill it in:
#
#   sudo install -m 600 -o root -g root deploy/relay-game.env.example /etc/relay-game.env
#   sudo nano /etc/relay-game.env
#
# systemd reads this file as root before it starts the service, so the
# service user never needs to read it, and should not be able to.
#
# One variable per line, KEY=value, no "export". Quotes are optional and are
# stripped. Check the result with:
#
#   sudo /srv/relay-game/.venv/bin/python -m backend.deploycheck --unit relay-game.service
#
# Make each key with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Every key below must be different, and none may stay "replace-me".
# (Local development uses .env.local instead; see .env.example.)


# --- host doors: REQUIRED ---------------------------------------------------
# The repository is public and every one of these defaults to "dev", so until
# they are set anybody can open these pages and run the games.

# /bullshithost: runs Bullshit Quiz, including the review that shows every answer.
RELAY_BULLSHIT_HOST_KEY=replace-me
# /quizhost: runs Guess Who and Roll Call.
RELAY_QUIZ_HOST_KEY=replace-me
# /god: controls real Relay matches (docs/GOD_MODE.md).
RELAY_GOD_KEY=replace-me
# /preview: the design gallery of throwaway matches. Less dangerous, still set it.
RELAY_PREVIEW_KEY=replace-me


# --- where the data lives: REQUIRED -----------------------------------------
# Outside the checkout, so a fresh clone can never delete it. The hardened
# unit can only write to /var/lib/relay. Create it first:
#   sudo install -d -m 750 -o relay -g relay /var/lib/relay

RELAY_DB_PATH=/var/lib/relay/relay.db
RELAY_BULLSHIT_DB=/var/lib/relay/bullshit.db
RELAY_ROLLCALL_DB=/var/lib/relay/rollcall.db
# Roll Call's roster of real email addresses, copied by hand, chmod 600.
# NOTHING may mail it until the repository owner says so: docs/ROLL_CALL_DO_NOT_SEND.md
#RELAY_ROLLCALL_ROSTER=/var/lib/relay/rollcall/roster.json


# --- the public address and mail: OPTIONAL, but together ---------------------
# Leave BOTH unset for a first night: accounts still work without email, but
# session cookies are not marked Secure and nobody can reset a forgotten
# password. Set RELAY_BASE_URL and the server REFUSES TO START until mail is
# configured too, because it would otherwise promise "check your email" and
# never send it. Mail setup and deliverability (SPF, DKIM): .env.example and
# docs/ACCOUNTS.md; prove it with `python -m backend.mailcheck`.

#RELAY_BASE_URL=https://relay.example.com
#RELAY_MAIL_BACKEND=smtp
#RELAY_MAIL_FROM="The Relay <no-reply@relay.example.com>"
#RELAY_SMTP_HOST=smtp.example.com
#RELAY_SMTP_PORT=587
#RELAY_SMTP_USER=relay@example.com
#RELAY_SMTP_PASSWORD=
#RELAY_SMTP_SECURITY=starttls
